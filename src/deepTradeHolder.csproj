<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>DeepTradeHolder</RootNamespace>
    <AssemblyName>DeepTradeHolder</AssemblyName>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>

  <PropertyGroup>
    <DeepchartDir Condition="'$(DeepchartDir)' == ''">C:\Program Files\Volumetrica Trading\Deepchart\</DeepchartDir>
    <DeepchartLibDir>$([MSBuild]::EnsureTrailingSlash('$(DeepchartDir)'))</DeepchartLibDir>
    <DeepchartDevId Condition="'$(DeepchartDevId)' == ''">YOUR-DEV-ID</DeepchartDevId>

    <!-- DeepCharts follows the Windows Documents folder. On systems where Documents is redirected
         to OneDrive, prefer that location; otherwise use the normal user Documents folder. -->
    <DeepchartIndicatorsDir Condition="'$(DeepchartIndicatorsDir)' == '' and '$(OneDrive)' != '' and Exists('$(OneDrive)\Documents')">$(OneDrive)\Documents\Deepchart\Indicators\</DeepchartIndicatorsDir>
    <DeepchartIndicatorsDir Condition="'$(DeepchartIndicatorsDir)' == ''">$(UserProfile)\Documents\Deepchart\Indicators\</DeepchartIndicatorsDir>
    <OutputPath Condition="'$(OutputPath)' == ''">$(DeepchartIndicatorsDir)</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="DeepchartDevId" Value="$(DeepchartDevId)" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="VolSysAPI">
      <HintPath>$(DeepchartLibDir)VolSysAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VolumetricaCore">
      <HintPath>$(DeepchartLibDir)VolumetricaCore.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CheckDeepchartSettings" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(DeepchartLibDir)VolSysAPI.dll') Or !Exists('$(DeepchartLibDir)VolumetricaCore.dll')"
           Text="VolSysAPI.dll and VolumetricaCore.dll were not found in '$(DeepchartDir)'. Set DeepchartDir to the folder Deepchart is installed in." />
    <Warning Condition="'$(DeepchartDevId)' == 'YOUR-DEV-ID'"
             Text="DeepchartDevId is not set: Deepchart will not load this dll. Pass -p:DeepchartDevId=... when building." />
  </Target>
</Project>
